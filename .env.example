# =============================================================================
# Network Traffic Investigation & Analysis Platform — Environment Configuration
# =============================================================================

# Application Settings
APP_NAME=NTIA Platform
APP_VERSION=1.0.0
DEBUG=false

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./data/traffic_analysis.db
# DATABASE_URL=postgresql://ntia_user:SecurePassword2026!@localhost:5432/ntia_db

# Security & Cryptographic Tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_a_random_64_character_hex_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Security Settings (set COOKIE_SECURE=true when running behind HTTPS/SSL)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:8001","http://127.0.0.1:5173","http://127.0.0.1:8001"]

# Brute-Force Defense & Lockout Policies
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Upload & File Inspection Limits
MAX_PCAP_SIZE_MB=100
UPLOAD_DIR=./uploads

# Modular Email Service Configuration
# Set SMTP_HOST to configure real SMTP delivery; leave blank for console dev logger
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ntia-platform.local
SMTP_USE_TLS=true

# Network Analyzer Tooling
TSHARK_PATH=tshark
